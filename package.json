{
  "name": "youtube-video-downloader",
  "version": "1.0.0",
  "description": "Desktop application for downloading YouTube videos on Debian Linux",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "start": "electron .",
    "build": "npm run build:renderer && electron-builder --linux deb"
  },
  "keywords": [
    "youtube",
    "downloader",
    "yt-dlp",
    "electron",
    "debian"
  ],
  "author": {
  "name": "Mithlesh Kumar Das",
  "email": "196286275+livelyfun@users.noreply.github.com"
  },
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.3.0",
    "electron-builder": "25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.local.yt-downloader",
    "productName": "YT Downloader",
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "src/main/**/*",
      "src/shared/**/*",
      "dist/renderer/**/*"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "synopsis": "YouTube Video Downloader",
      "description": "Download YouTube videos locally using yt-dlp",
      "desktop": {
        "Name": "YT Downloader",
        "Comment": "Download YouTube videos locally",
        "Terminal": "false",
        "Categories": "Utility;Network;"
      }
    },
    "deb": {
      "depends": [
        "ffmpeg",
        "python3"
      ]
    }
  }
}
